{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>NVIDIA-NeMo/FW-CI-templates//renovate-config/python-uv#add-renovate-config-2"
  ],
  "baseBranchPatterns": [
    "$default"
  ],
  "constraints": {
    "uv": "0.11.8"
  },
  "packageRules": [
    {
      "description": "Keep execution backends and their direct SDKs in one non-major update PR.",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "torchx",
        "leptonai",
        "skypilot",
        "ray",
        "kubernetes"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python integrations",
      "groupSlug": "python-integrations",
      "groupSingleUpdates": true
    }
  ]
}
